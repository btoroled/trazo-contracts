{
  "name": "trazo-contracts",
  "version": "0.1.0",
  "description": "ChainLock smart contracts for Trazo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy-local.ts --network localhost",
    "security:check": "pwsh -NoProfile -File scripts/check-secrets.ps1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.1",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "hardhat": "^3.13.0",
    "mocha": "^11.8.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
